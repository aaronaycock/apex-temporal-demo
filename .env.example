# Copy to .env and fill in. .env is gitignored.

# Temporal (defaults match docker-compose.yml)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_NONPROD=nonprod-provisioning

# Terraform remote state: an existing S3 bucket you can read and write.
# No DynamoDB lock table: the modules use S3 native locking (use_lockfile),
# which needs Terraform 1.10+.
TF_STATE_BUCKET=
TF_STATE_REGION=us-east-1

# Optional: Grafana Cloud metrics (only for `docker compose --profile metrics`)
GRAFANA_PROM_REMOTE_WRITE_URL=
GRAFANA_PROM_USERNAME=
GRAFANA_PROM_API_KEY=
